[{"t0": 0.0, "t1": 1.74, "text": "Este animal nació cuando todavía"}, {"t0": 1.74, "t1": 4.06, "text": "no existían ni el teléfono ni la bombilla."}, {"t0": 4.48, "t1": 5.26, "text": "Y sigue vivo."}, {"t0": 5.74, "t1": 7.5, "text": "Se llama Jonathan y tiene unos"}, {"t0": 7.5, "t1": 9.02, "text": "194 años."}, {"t0": 9.64, "t1": 11.48, "text": "Jonathan es una tortuga gigante"}, {"t0": 11.48, "t1": 12.08, "text": "de Aldabra."}, {"t0": 12.44, "t1": 13.92, "text": "Se calcula que salió del huevo"}, {"t0": 13.92, "t1": 15.8, "text": "hacia 1832."}, {"t0": 16.2, "t1": 19.02, "text": "En 1882 llegó desde las Seychelles"}, {"t0": 19.02, "t1": 20.34, "text": "a la isla de Santa Elena,"}, {"t0": 20.64, "t1": 21.58, "text": "en mitad del Atlántico,"}, {"t0": 21.84, "t1": 23.14, "text": "como regalo para el gobernador."}, {"t0": 23.62, "t1": 24.44, "text": "Ya era adulto."}, {"t0": 24.88, "t1": 26.56, "text": "Hoy es el animal terrestre vivo"}, {"t0": 26.56, "t1": 28.04, "text": "más viejo que se conoce."}, {"t0": 28.56, "t1": 28.84, "text": "Ahora,"}, {"t0": 29.2, "t1": 30.66, "text": "un equipo internacional ha leído"}, {"t0": 30.66, "t1": 31.32, "text": "su ADN."}, {"t0": 31.7, "t1": 33.3, "text": "Como en la isla no permiten sacarle"}, {"t0": 33.3, "t1": 35.54, "text": "sangre, usaron un raspado de la mejilla."}, {"t0": 35.96, "t1": 37.16, "text": "El primer intento falló:"}, {"t0": 37.52, "t1": 38.66, "text": "solo salieron bacterias."}, {"t0": 39.22, "t1": 39.96, "text": "¿Y qué han encontrado?"}, {"t0": 39.96, "t1": 42.32, "text": "287 variantes"}, {"t0": 42.32, "t1": 43.88, "text": "genéticas propias de Jonathan,"}, {"t0": 44.34, "t1": 46.12, "text": "en genes relacionados con la reparación"}, {"t0": 46.12, "t1": 47.9, "text": "del ADN y con los telómeros,"}, {"t0": 48.14, "t1": 49.46, "text": "los extremos de los cromosomas."}, {"t0": 49.92, "t1": 51.62, "text": "Y algo todavía más curioso."}, {"t0": 51.96, "t1": 52.5, "text": "Con la edad,"}, {"t0": 52.78, "t1": 54.3, "text": "las marcas químicas que encienden"}, {"t0": 54.3, "t1": 56.28, "text": "y apagan los genes se van desordenando."}, {"t0": 56.28, "t1": 58.12, "text": "En Jonathan eso pasa en casi"}, {"t0": 58.12, "t1": 58.98, "text": "todo el genoma,"}, {"t0": 59.26, "t1": 61.14, "text": "salvo en los genes de las mitocondrias,"}, {"t0": 61.5, "t1": 63.16, "text": "las centrales de energía de la célula."}, {"t0": 63.56, "t1": 65.94, "text": "Ahí sus marcas siguen sorprendentemente"}, {"t0": 65.94, "t1": 66.56, "text": "ordenadas."}, {"t0": 67.14, "t1": 67.42, "text": "Ojo:"}, {"t0": 67.82, "t1": 68.9, "text": "es un solo animal,"}, {"t0": 68.9, "t1": 70.88, "text": "y el estudio no demuestra que esos"}, {"t0": 70.88, "t1": 72.68, "text": "genes sean la causa de su longevidad."}, {"t0": 73.04, "t1": 74.6, "text": "Un experto que no participó lo"}, {"t0": 74.6, "t1": 75.26, "text": "resumió así:"}, {"t0": 75.72, "t1": 77.64, "text": "quizá Jonathan simplemente es muy"}, {"t0": 77.64, "t1": 78.68, "text": "bueno siendo viejo."}, {"t0": 79.08, "t1": 80.62, "text": "Aun así, según sus autores,"}, {"t0": 81.02, "t1": 82.8, "text": "es el primer estudio del epigenoma"}, {"t0": 82.8, "t1": 84.06, "text": "de una tortuga gigante."}, {"t0": 84.06, "t1": 87.0, "text": "¿Te gustaría vivir 200 años si pudieras?"}]