[{"t0": 0, "t1": 0.96, "text": "Hay estrellas que mueren"}, {"t0": 0.98, "t1": 2.18, "text": "sin hacer ruido."}, {"t0": 2.2, "t1": 4.62, "text": "Sin explosión, sin supernova:"}, {"t0": 4.64, "t1": 6.54, "text": "simplemente se apagan y dejan"}, {"t0": 6.56, "t1": 7.84, "text": "un agujero negro."}, {"t0": 7.86, "t1": 9.84, "text": "Y ahora tenemos la primera pista de"}, {"t0": 9.86, "t1": 12.22, "text": "que esto podría pasar muchísimo."}, {"t0": 12.24, "t1": 14.8, "text": "Según los libros, lo normal es esto."}, {"t0": 14.82, "t1": 17.28, "text": "Una estrella gigante agota su combustible"}, {"t0": 17.3, "t1": 19.12, "text": "su núcleo se hunde y la estrella"}, {"t0": 19.14, "t1": 21.22, "text": "revienta en una supernova, una de"}, {"t0": 21.24, "t1": 23.06, "text": "las explosiones más brillantes del"}, {"t0": 23.08, "t1": 23.96, "text": "universo."}, {"t0": 23.98, "t1": 25.92, "text": "Lo que queda en el centro puede convertirse"}, {"t0": 25.94, "t1": 26.86, "text": "en un agujero negro."}, {"t0": 26.88, "t1": 29.46, "text": "Pero un equipo de Caltech ha revisado"}, {"t0": 29.48, "t1": 31.56, "text": "doscientas cincuenta y siete colisiones"}, {"t0": 31.58, "t1": 33.28, "text": "de agujeros negros detectadas por"}, {"t0": 33.3, "t1": 35.2, "text": "LIGO, Virgo y KAGRA."}, {"t0": 35.22, "t1": 36.72, "text": "Son observatorios que captan"}, {"t0": 36.74, "t1": 38.34, "text": "ondas gravitacionales:"}, {"t0": 38.36, "t1": 39.96, "text": "temblores del propio espacio que"}, {"t0": 39.98, "t1": 41.88, "text": "llegan a la Tierra tras viajar cientos"}, {"t0": 41.9, "t1": 43.42, "text": "de millones de años."}, {"t0": 43.44, "t1": 45.2, "text": "Y han encontrado dos cosas raras."}, {"t0": 45.22, "t1": 46.7, "text": "Primera:"}, {"t0": 46.72, "t1": 48.22, "text": "los agujeros negros de unas diez"}, {"t0": 48.24, "t1": 51.1, "text": "veces la masa del Sol son, con diferencia"}, {"t0": 51.12, "t1": 52.04, "text": "los más abundantes."}, {"t0": 52.06, "t1": 53.54, "text": "Segunda:"}, {"t0": 53.56, "t1": 55.46, "text": "casi no hay ninguno entre doce"}, {"t0": 55.48, "t1": 57.68, "text": "y dieciséis masas solares."}, {"t0": 57.7, "t1": 58.74, "text": "Un hueco."}, {"t0": 58.76, "t1": 60.8, "text": "Es la primera vez que se detecta."}, {"t0": 60.82, "t1": 62.08, "text": "¿Cómo se explica?"}, {"t0": 62.1, "t1": 64.2, "text": "Su hipótesis es que muchas estrellas de"}, {"t0": 64.22, "t1": 66.6, "text": "ese tamaño colapsan directamente."}, {"t0": 66.62, "t1": 68.46, "text": "El núcleo se traga la estrella entera"}, {"t0": 68.48, "t1": 70.24, "text": "antes de que pueda explotar."}, {"t0": 70.26, "t1": 72.02, "text": "Una supernova fallida."}, {"t0": 72.04, "t1": 72.7, "text": "Ojo:"}, {"t0": 72.72, "t1": 74.26, "text": "no es una prueba directa."}, {"t0": 74.28, "t1": 76.84, "text": "Nadie ha confirmado todavía un caso concreto"}, {"t0": 76.86, "t1": 78.46, "text": "y los propios autores dicen que hace"}, {"t0": 78.48, "t1": 79.46, "text": "falta más investigación."}, {"t0": 79.48, "t1": 81.58, "text": "Pero el patrón encaja con lo"}, {"t0": 81.6, "t1": 82.98, "text": "que predice la teoría."}, {"t0": 83.0, "t1": 84.94, "text": "Si tienen razón, el universo está"}, {"t0": 84.96, "t1": 87.22, "text": "lleno de estrellas que un día desaparecieron"}, {"t0": 87.24, "t1": 88.5, "text": "sin despedirse."}, {"t0": 88.52, "t1": 90.22, "text": "¿Qué te parece más inquietante:"}, {"t0": 90.24, "t1": 92.0, "text": "una estrella que explota o una"}, {"t0": 92.02, "t1": 93.5, "text": "que se esfuma sin más?"}]